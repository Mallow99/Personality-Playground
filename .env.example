# Start with the visibly labeled, scripted mock. It does not run a model.
BFI_BACKEND=mock
# Connection preset: custom, llama_cpp, strata, lmstudio, ollama.
# Presets choose conventional local ports; explicit BASE_URL still wins.
# For a preset's default port, remove the explicit BFI_BASE_URL below.
BFI_RUNTIME=custom
# For real inference, set BFI_BACKEND=openai and start a compatible server separately.
# Loopback endpoints only in milestone 1. Include /v1, without /chat/completions.
BFI_BASE_URL=http://127.0.0.1:8080/v1
BFI_MODEL=local-model
# Optional local server key; never committed or returned to the browser.
BFI_API_KEY=
BFI_TIMEOUT_SECONDS=120
BFI_MAX_TOKENS=512
BFI_TEMPERATURE=0.7
# BFI_TOP_P=0.95
BFI_QUEUE_LIMIT=16
BFI_MEMORY_CHARS=4000
# Limits are approximate context guards, not tokenizer-aware budgeting.
BFI_HISTORY_PAIRS=12
BFI_CONTEXT_CHARS=24000
# Relative paths are resolved from the repository root.
BFI_DATA_DIR=data
BFI_CHARACTER_FILE=config/character.json
BFI_PROFILES_FILE=config/profiles.json
# Optional profile routing overrides: ACADEMIC, ENGINEERING, BUSINESS.
# All profiles otherwise inherit BFI_BACKEND, BFI_BASE_URL, BFI_MODEL, and BFI_API_KEY.
# BFI_ENGINEERING_BACKEND=openai
# BFI_ENGINEERING_RUNTIME=llama_cpp
# BFI_ENGINEERING_MAX_TOKENS=1024
# BFI_ENGINEERING_TEMPERATURE=0.3
# BFI_ENGINEERING_BASE_URL=http://127.0.0.1:8081/v1
# BFI_ENGINEERING_MODEL=your-coding-model-alias
# BFI_ACADEMIC_ADAPTER_LABEL=study-personality-r1
# Adapter labels are metadata, not loading/training commands or proof of custom weights.

# Optional real tools. Both default to disabled.
# BFI_PROJECT_ROOT=.
BFI_BRAVE_API_KEY=
